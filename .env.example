PORT=3000

# ngrok tunnel (get authtoken from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

DB_HOST=localhost
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=drink_order_app

JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d

# SePay payment gateway
# Đăng ký tại https://sepay.vn → Cấu hình → API Key
SEPAY_API_KEY=your_sepay_api_key_here
# Mã ngân hàng (MB, VCB, TCB, ...)
SEPAY_BANK_CODE=MB
# Số tài khoản ngân hàng nhận tiền
SEPAY_ACCOUNT_NUMBER=1234567890
# Tiền tố nội dung chuyển khoản (DRK → DRK1, DRK2, ...)
SEPAY_PAYMENT_PREFIX=DRK
